backend/models/birefnet/
backend/models/modnet/
backend/models/iclight/
backend/models/midas/

# ─── Runtime data ─────────────────────────────────────────────
backend/uploads/
backend/outputs/
backend/frames/
!backend/uploads/.gitkeep
!backend/outputs/.gitkeep
!backend/frames/.gitkeep

