# SwitchX Clone - Backend Environment Variables
# Copy this file to .env and adjust values

PORT=3001
NODE_ENV=development

# Python binary to use for AI pipeline
PYTHON_BIN=python3

# GPU: set to "cuda" to force GPU, "cpu" to force CPU, "auto" to detect
TORCH_DEVICE=auto

# HuggingFace cache directory (for model weights)
HF_HOME=./models/huggingface
TRANSFORMERS_CACHE=./models/huggingface

# Max upload file size in MB
MAX_UPLOAD_MB=200

# Cleanup frames after processing (true/false)
CLEANUP_FRAMES=true

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
